# Binance API credentials (use testnet keys for paper trading)
# Create at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: enable only "Read" + "Spot trading", DISABLE withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Telegram alerts (optional, recommended)
# Create bot via @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
LOG_LEVEL=INFO
DATA_DIR=./data

# --- solana_watcher (phase 1: copy-smart-money observatory) ---
# Free API key from https://www.helius.dev/ (100k req/day is plenty)
HELIUS_API_KEY=
# Mute alerts for buys smaller than this estimated USD value. 0 = no filter.
MIN_BUY_USD=100
