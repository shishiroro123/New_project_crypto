# Binance API credentials (use testnet keys for paper trading)
# Create at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: enable only "Read" + "Spot trading", DISABLE withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Telegram alerts (optional, recommended)
# Create bot via @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
LOG_LEVEL=INFO
DATA_DIR=./data
